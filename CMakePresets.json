{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with debug symbols (-g)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with performance optimization (-O3)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-debug",
      "displayName": "Android Debug",
      "description": "Android Debug build for Qt Creator",
      "binaryDir": "${sourceDir}/build/android-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_GUI": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_TUI": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-release",
      "displayName": "Android Release",
      "description": "Android Release build for Qt Creator",
      "binaryDir": "${sourceDir}/build/android-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_GUI": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_TUI": "OFF",
        "BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "release"
    },
    {
      "name": "android-debug",
      "displayName": "Android Debug Build",
      "configurePreset": "android-debug"
    },
    {
      "name": "android-release",
      "displayName": "Android Release Build",
      "configurePreset": "android-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug Tests",
      "configurePreset": "debug"
    }
  ]
}
