{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with debug symbols (-g)",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with performance optimization (-O3)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-debug",
      "displayName": "Android Debug",
      "description": "Android Debug build for Qt Creator",
      "binaryDir": "${sourceDir}/build/android-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_GUI": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_TUI": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-release",
      "displayName": "Android Release",
      "description": "Android Release build for Qt Creator",
      "binaryDir": "${sourceDir}/build/android-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_GUI": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_TUI": "OFF",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "pi-release",
      "displayName": "Raspberry Pi Release",
      "description": "Release build for Raspberry Pi and ARM SBCs",
      "binaryDir": "${sourceDir}/build/pi-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_GUI": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_TUI": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "pi-headless-release",
      "displayName": "Raspberry Pi Headless Release",
      "description": "Headless Release build (Server + TUI) for Raspberry Pi",
      "binaryDir": "${sourceDir}/build/pi-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_GUI": "OFF",
        "BUILD_SERVER": "ON",
        "BUILD_TUI": "ON",
        "BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "release"
    },
    {
      "name": "android-debug",
      "displayName": "Android Debug Build",
      "configurePreset": "android-debug"
    },
    {
      "name": "android-release",
      "displayName": "Android Release Build",
      "configurePreset": "android-release"
    },
    {
      "name": "pi-release",
      "displayName": "Raspberry Pi Release Build",
      "configurePreset": "pi-release"
    },
    {
      "name": "pi-headless-release",
      "displayName": "Raspberry Pi Headless Release Build",
      "configurePreset": "pi-headless-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Debug Tests",
      "configurePreset": "debug"
    },
    {
      "name": "pi-release",
      "displayName": "Raspberry Pi Tests",
      "configurePreset": "pi-release"
    }
  ]
}
